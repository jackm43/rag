{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "types": [
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "test/index.test.ts",
    "test/verify.test.ts",
    "test/interactions.test.ts",
    "test/db.test.ts",
    "test/ai-config.test.ts",
    "test/commands.test.ts",
    "test/register-payload.test.ts",
    "test/apply-migrations.ts",
    "scripts/register-commands.ts",
    "vitest.config.ts"
  ]
}
