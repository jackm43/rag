{
  "name": "ragbot-dev-ui",
  "main": "dev/entry.py",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "secrets": {
    "required": [
      "CF_AIG_TOKEN",
      "CLOUDFLARE_API_TOKEN"
    ]
  },
  "dev": {
    "ip": "localhost",
    "port": 8788
  },
  "vars": {
    "DEV_UI": "1",
    "DISCORD_APPLICATION_ID": "1496842508251172895",
    "CF_ACCOUNT_ID": "314e7e015b5f4429c4e2da1e6ec93271",
    "ALLOWED_GUILD_IDS": "457689460096630794",
    "CF_AIG_GATEWAY_ID": "platy",
    "DISCORD_BOT_TOKEN": "dev-unused",
    "DISCORD_PUBLIC_KEY": "dev-unused",
    "GATEWAY_CONTROL_TOKEN": "dev-unused"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragbot",
      "database_id": "5833b0bb-7806-483e-9015-32e209ce2fb0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AI_CONFIG",
      "id": "2a6dbd4428b64d6982bfe628445c163a"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
