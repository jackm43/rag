{
  "name": "ragbot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "wrangler dev -c apps/bot/workers/gateway/api/middleware_client/wrangler.jsonc",
    "dev:all": "wrangler dev -c apps/bot/workers/gateway/api/middleware_client/wrangler.jsonc -c apps/bot/workers/workflows/wrangler.jsonc -c apps/bot/workers/responder/wrangler.jsonc -c apps/bot/workers/spend/wrangler.jsonc",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:main": "wrangler deploy -c apps/bot/workers/gateway/api/middleware_client/wrangler.jsonc",
    "check": "tsc --noEmit && tsx scripts/check-dep-direction.ts",
    "test": "vitest run",
    "contracts:build": "capnp-es packages/contracts-core/envelope.capnp packages/contracts-core/service.capnp -ots",
    "routes:build": "tsx scripts/generate-gateway-routes.ts && tsx scripts/generate-openapi.ts",
    "devproxy:page:build": "vite build --config apps/connectors/workers/dev-proxy/web/vite.config.ts && tsx scripts/embed-devproxy-page.ts",
    "devproxy:github-routes:sync": "tsx scripts/sync-github-rest-routes.ts && wrangler r2 object put ragbot-devproxy-assets/github/rest-routes.json --file dist/github-rest-routes.json --content-type application/json --cache-control \"public, max-age=3600\" --remote",
    "devproxy:types": "openapi-typescript apps/connectors/workers/dev-proxy/api/middleware_client/openapi.yaml -o apps/connectors/devproxy-client/api-types.ts",
    "ragctl": "tsx cli/ragctl.ts",
    "register:commands": "tsx scripts/register-commands.ts",
    "linked-app-token:hash": "node scripts/hash-linked-app-token.mjs",
    "config:push": "tsx scripts/push-config.ts",
    "backfill:spend": "tsx scripts/backfill-spend.ts",
    "d1:migrate:local": "wrangler d1 migrations apply ragbot -c apps/bot/workers/gateway/api/middleware_client/wrangler.jsonc --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ragbot -c apps/bot/workers/gateway/api/middleware_client/wrangler.jsonc --remote",
    "deploy:webhooks": "tsx scripts/deploy.ts --only webhooks",
    "deploy:dev-proxy": "tsx scripts/deploy.ts --only dev-proxy",
    "scaffold": "tsx scripts/scaffold.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "discord.js": "^14.26.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.13.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@1password/sdk": "^0.4.0",
    "@cedar-policy/cedar-wasm": "^4.11.2",
    "@rag/authz": "workspace:*",
    "@rag/bot": "workspace:*",
    "@rag/connectors": "workspace:*",
    "@rag/contracts-core": "workspace:*",
    "@rag/egress": "workspace:*",
    "@rag/ingress": "workspace:*",
    "@rag/logger": "workspace:*",
    "@rag/platform": "workspace:*",
    "@rag/secrets": "workspace:*",
    "@rag/service-kit": "workspace:*",
    "better-auth": "^1.6.23",
    "capnp-es": "^0.0.14",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "undici": "6.27.0"
    }
  }
}
