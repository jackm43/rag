{
  "name": "ragbot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "uv run python scripts/worker.py dev",
    "deploy": "uv run pywrangler deploy",
    "check": "uv run python scripts/check.py",
    "test": "uv run pytest",
    "test:runtime": "uv run python scripts/runtime_test.py",
    "types": "uv run pywrangler types",
    "register:commands": "uv run python scripts/register_commands.py",
    "d1:migrate:local": "wrangler d1 migrations apply ragbot --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ragbot --remote",
    "dev:ui": "op run --env-file=.env --env-file=.env.dev -- uv run python scripts/dev_ui.py",
    "settings:init:local": "uv run python scripts/initialize_ai_settings.py --local"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
