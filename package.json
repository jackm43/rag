{
  "name": "ragbot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c workers/public/gateway/wrangler.jsonc",
    "dev:all": "wrangler dev -c workers/public/gateway/wrangler.jsonc -c workers/services/workflows/wrangler.jsonc -c workers/services/responder/wrangler.jsonc -c workers/services/spend/wrangler.jsonc",
    "deploy": "wrangler deploy -c workers/services/responder/wrangler.jsonc && wrangler deploy -c workers/public/gateway/wrangler.jsonc && wrangler deploy -c workers/services/workflows/wrangler.jsonc && wrangler deploy -c workers/services/spend/wrangler.jsonc",
    "deploy:main": "wrangler deploy -c workers/public/gateway/wrangler.jsonc",
    "deploy:workflows": "wrangler deploy -c workers/services/workflows/wrangler.jsonc",
    "deploy:responder": "wrangler deploy -c workers/services/responder/wrangler.jsonc",
    "deploy:spend": "wrangler deploy -c workers/services/spend/wrangler.jsonc",
    "deploy:webhooks": "wrangler deploy -c workers/public/webhooks/wrangler.jsonc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "contracts:build": "capnp-es packages/contracts/envelope.capnp packages/contracts/service.capnp -ots",
    "routes:build": "tsx scripts/generate-gateway-routes.ts",
    "devproxy:types": "openapi-typescript workers/public/dev-proxy/openapi.yaml -o packages/devproxy-client/api-types.ts",
    "ragctl": "tsx cli/ragctl.ts",
    "register:commands": "tsx scripts/register-commands.ts",
    "config:push": "tsx scripts/push-config.ts",
    "backfill:spend": "tsx scripts/backfill-spend.ts",
    "d1:migrate:local": "wrangler d1 migrations apply ragbot -c workers/public/gateway/wrangler.jsonc --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ragbot -c workers/public/gateway/wrangler.jsonc --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@types/node": "^25.6.0",
    "discord.js": "^14.26.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.13.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.11.2",
    "better-auth": "^1.6.23",
    "capnp-es": "^0.0.14",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
