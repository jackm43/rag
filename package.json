{
  "name": "ragbot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:all": "wrangler dev -c wrangler.jsonc -c wrangler.brain.jsonc -c wrangler.spend.jsonc",
    "deploy": "wrangler deploy && wrangler deploy -c wrangler.brain.jsonc && wrangler deploy -c wrangler.spend.jsonc",
    "deploy:main": "wrangler deploy",
    "deploy:brain": "wrangler deploy -c wrangler.brain.jsonc",
    "deploy:spend": "wrangler deploy -c wrangler.spend.jsonc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "contracts:build": "capnp-es src/contracts/envelope.capnp -ots",
    "register:commands": "tsx scripts/register-commands.ts",
    "backfill:spend": "tsx scripts/backfill-spend.ts",
    "d1:migrate:local": "wrangler d1 execute ragbot --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute ragbot --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@types/node": "^25.6.0",
    "discord.js": "^14.26.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.13.2"
  },
  "dependencies": {
    "capnp-es": "^0.0.14",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
