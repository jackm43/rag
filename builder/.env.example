# Copy to .env.builder at the repository root; use 1Password references for secrets.
BUILDER_APP_DOMAIN=games.your-domain.com
BUILDER_ZONE_NAME=your-domain.com
GITHUB_REPOSITORY=owner/rag
GITHUB_BASE_BRANCH=main
OPENAI_API_KEY=op://YOUR_VAULT/ragbot-builder/openai-api-key
DISCORD_CLIENT_SECRET=op://YOUR_VAULT/ragbot-builder/discord-client-secret
GITHUB_TOKEN=op://YOUR_VAULT/ragbot-builder/github-token
# DISCORD_APPLICATION_ID, DISCORD_BOT_TOKEN, CLOUDFLARE_API_TOKEN come from .env.
