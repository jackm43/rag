{
  "name": "ragbot-brain-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md",
        "**/*.cedar"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "DISCORD_APPLICATION_ID": "1496842508251172895",
    "CF_ACCOUNT_ID": "314e7e015b5f4429c4e2da1e6ec93271"
    // Guild allowlist (comma-separated guild snowflakes). Unset allows all
    // guilds with a warning; set it to fail closed, e.g.:
    // "ALLOWED_GUILD_IDS": "123456789012345678"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragbot",
      "database_id": "5833b0bb-7806-483e-9015-32e209ce2fb0",
      "migrations_dir": "../../../migrations"
    }
  ],
  // AI prompt/config store. Only the brain runs AI, so only it binds this.
  // loadConfig reads keys (file basenames) with a bundled fallback, so a fresh
  // or empty namespace still works. Operator bootstrap (one time):
  //   wrangler kv namespace create AI_CONFIG
  // then paste the printed id below, and `npm run config:push` (also run by
  // deploy.sh after deploy) uploads the ai-config files.
  "kv_namespaces": [
    {
      "binding": "AI_CONFIG",
      "id": "REPLACE_WITH_AI_CONFIG_KV_NAMESPACE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "RESPONDER",
      "service": "ragbot-responder-worker",
      "entrypoint": "Responder"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SPEND_JOBS",
        "queue": "ai-spend-jobs"
      },
      {
        "binding": "DISCORD_OUTBOX",
        "queue": "discord-outbox"
      }
    ],
    "consumers": [
      {
        "queue": "ai-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "dead_letter_queue": "ai-jobs-dlq"
      },
      {
        "queue": "ai-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 1
      }
    ]
  }
}
