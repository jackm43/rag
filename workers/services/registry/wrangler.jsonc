{
  "name": "ragbot-registry-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "CF_ACCOUNT_ID": "314e7e015b5f4429c4e2da1e6ec93271"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  // This worker DEFINES the ServiceRegistry Durable Object. Every other worker
  // binds it via `script_name: "ragbot-registry-worker"`.
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE_REGISTRY",
        "class_name": "ServiceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ServiceRegistry"
      ]
    }
  ]
}
