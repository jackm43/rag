{
  "name": "ragbot-responder-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.cedar"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  // Service registry hosted by the standalone ragbot-registry-worker.
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE_REGISTRY",
        "class_name": "ServiceRegistry",
        "script_name": "ragbot-registry-worker"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "queues": {
    "consumers": [
      {
        "queue": "discord-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "discord-outbox-dlq"
      },
      {
        "queue": "discord-outbox-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 1
      }
    ]
  }
}
