{
  "name": "ragbot-dev-proxy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "rules": [
    {
      // The auth/authz packages this worker imports load
      // Cedar policy files as Text, exactly like the other workers.
      "type": "Text",
      "globs": [
        "**/*.md",
        "**/*.cedar"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  // Put a Cloudflare Access application in front of this hostname. Access is the
  // first gate; the worker cryptographically verifies the Access JWT it
  // forwards (CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD below).
  "routes": [
    {
      "pattern": "ragbot-dev.jsmunro.me",
      "custom_domain": true
    }
  ],
  "vars": {
    "DISCORD_APPLICATION_ID": "1496842508251172895",
    "CF_ACCESS_TEAM_DOMAIN": "jsmunro.cloudflareaccess.com",
    "BETTER_AUTH_URL": "https://ragbot-dev.jsmunro.me",
    "DEV_PROXY_GUILD": "457689460096630794"
    // CF_ACCESS_AUD is set as a secret after the Access application is created
    // (its AUD tag). Until then the Access guard fails closed (401 for all).
    // Secret (never commit) — set with `wrangler secret put <NAME>`:
    //   DEV_PROXY_SIGNING_KEY   (private JWK from scripts/generate-keys.ts dev-proxy)
    //   DISCORD_CLIENT_ID       (Discord OAuth application client id)
    //   DISCORD_CLIENT_SECRET   (Discord OAuth application client secret)
    //   BETTER_AUTH_SECRET      (random 32+ byte secret; signs sessions/cookies)
    // The acting Discord subject is now the authenticated Better Auth session, not
    // an env default. On the GATEWAY worker keep the allowlist of Discord ids the
    // proxy may act as (defense in depth):
    //   "DEV_PROXY_ALLOWED_SUBJECTS": "<comma-separated Discord user ids>"
  },
  // Better Auth's application-identity store (Discord OAuth login behind
  // Access). A standalone D1 database, separate from the gateway's `ragbot`
  // operational DB, so login/session state never mingles with product data.
  // Apply its schema before deploy:
  //   wrangler d1 migrations apply ragbot-auth -c workers/applications/dev-proxy/api/middleware_client/wrangler.jsonc --remote
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ragbot-auth",
      "database_id": "2768451b-39c6-4e8f-ada6-13c8beb2012e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DEVPROXY_ASSETS",
      "bucket_name": "ragbot-devproxy-assets"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      // Service registry hosted by the standalone ragbot-registry-worker.
      {
        "name": "SERVICE_REGISTRY",
        "class_name": "ServiceRegistry",
        "script_name": "ragbot-registry-worker"
      }
    ]
  },
  // The dev-proxy's egress, both service-binding hops (never a public route):
  //   - the gateway's DevProxy entrypoint (the command surface), and
  //   - the connectors broker's Connectors entrypoint (the admin surface, for
  //     the connector.admin.* management ops behind /api/connectors/*).
  // A service binding is invocable solely by a worker configured with it, so
  // these hops are reachable only from here.
  "services": [
    {
      "binding": "GATEWAY_DEVPROXY",
      "service": "ragbot-worker",
      "entrypoint": "DevProxy"
    },
    {
      "binding": "CONNECTORS",
      "service": "ragbot-connectors-worker",
      "entrypoint": "Connectors"
    }
  ]
}
