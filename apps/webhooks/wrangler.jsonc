{
  "name": "ragbot-webhooks-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "rules": [
    {
      // The auth/authz packages this worker imports load
      // Cedar policy files as Text, exactly like the other workers.
      "type": "Text",
      "globs": [
        "**/*.md",
        "**/*.cedar"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    // Discord application public keys for interaction-signature verification,
    // keyed by application (client) id: { "<clientId>": "<hex public key>" }.
    // Public keys only verify Ed25519 signatures (they cannot sign), so this is
    // safe to embed as a plaintext var rather than a secret. The interactions
    // route resolves the key per {clientId}; an unregistered id 404s.
    // Value below is the ragbot application (id 1496842508251172895); its
    // public key is op://Services/ragbot/PublicKey.
    "DISCORD_INTERACTION_PUBLIC_KEYS": "{\"1496842508251172895\":\"1db2d138bb69ded0c0baff472b20bfc2fa4ca62770af2109f41c02436d53daec\"}"
  },
  // The centralised webhook-ingress hostname (CONNECTORS.md "URL conventions":
  // a connector's inbound webhook is webhooks.jsmunro.me/{provider}/{id}).
  // The host is behind Cloudflare Access (service-token-only Allow policy), but
  // the provider hook paths /github/* and /stripe/* carry a Bypass=Everyone
  // Access policy — third-party providers POST there and cannot pass an Access
  // ceremony, so the provider's HMAC signature (verified broker-side via
  // connector.webhook.verify) remains the authentication for those paths. Every
  // other path (e.g. /openapi.json) requires the ragbot-webhooks service token.
  // Access apps: "ragbot webhooks" (host), "ragbot webhooks — github/stripe
  // (public)" (path bypass).
  //
  // The Discord interactions path /{clientId}/interactions ALSO needs a
  // Bypass=Everyone Access policy: Discord POSTs interaction callbacks and
  // likewise cannot pass an Access ceremony — the Ed25519 signature (verified
  // in-worker against the app's public key) is the authentication. Add the path
  // pattern webhooks.jsmunro.me/*/interactions to the existing public bypass
  // Access app (a manual Cloudflare-side step, done at cutover).
  "routes": [
    {
      "pattern": "webhooks.jsmunro.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      // TTL'd webhook-replay dedupe store (one object per connector, keyed by
      // the broker-returned provider event id). Defined by this worker.
      {
        "name": "WEBHOOK_DEDUPE",
        "class_name": "WebhookDedupe"
      },
      // The bot's InteractionSession processor DO, defined by the workflows
      // worker. Bound cross-script (no migration on the binding side) so the
      // interactions route can kick run() after verifying the Discord
      // signature. The workflows worker must be deployed before this binding
      // resolves — it is in the core DEPLOY_ORDER, which runs before this
      // worker's manual `--only webhooks` bootstrap (scripts/deploy.ts).
      {
        "name": "INTERACTION_SESSION",
        "class_name": "InteractionSession",
        "script_name": "ragbot-workflows-worker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "WebhookDedupe"
      ]
    }
  ],
  // Verified events are enqueue-only to the workflows worker (providers retry on
  // non-2xx/timeout, so nothing slow may run inline).
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_JOBS",
        "queue": "webhook-jobs"
      }
    ]
  },
  // The credential broker's Connectors entrypoint: the webhook_verify hop.
  // A service binding is invocable solely by a worker configured with it; the
  // broker returns only { valid, eventId? } — the webhook secret never
  // reaches this worker (the phantom-token philosophy, applied inbound).
  "services": [
    {
      "binding": "AUTH",
      "service": "ragbot-auth-worker",
      "entrypoint": "AuthGateway"
    }
  ]
}
